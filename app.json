{
  "expo": {
    "name": "ExpenseTracker",
    "slug": "expense-tracker",
    "scheme": "expensetracker",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#130C1F"
    },
    "assetBundlePatterns": ["**/*"],
    "android": {
      "package": "com.expensetracker.app",
      "permissions": ["READ_SMS", "POST_NOTIFICATIONS"]
    },
    "plugins": [
      "expo-asset",
      "expo-sqlite",
      "expo-sharing",
      "expo-notifications"
    ],
    "extra": {
      "eas": {
        "projectId": "f215acef-5341-4f21-bb1b-67eb4245c1dc"
      }
    }
  }
}
