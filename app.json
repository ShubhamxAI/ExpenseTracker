{
  "expo": {
    "name": "ExpenseTracker",
    "slug": "expense-tracker",
    "scheme": "expensetracker",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#130C1F"
    },
    "assetBundlePatterns": ["**/*"],
    "android": {
      "package": "com.expensetracker.app"
    },
    "plugins": ["expo-asset", "expo-sqlite", "expo-sharing"]
  }
}
